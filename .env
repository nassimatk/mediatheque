# Valeurs de DÉVELOPPEMENT uniquement. Aucun secret réel ici.
# Pour surcharger en local : créer .env.local (ignoré par Git).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev-only-secret-change-me
DEFAULT_URI="http://localhost:8081"
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://app:app@database:3306/mediatheque?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> open-library ###
# Email de contact envoyé dans le User-Agent vers Open Library (voir D-015).
# Pour changer : créer .env.local (ignoré par Git) et surcharger cette variable.
OPENLIBRARY_CONTACT=contact@mediatheque.local
###< open-library ###

###> docker compose ###
# Utilisées par compose.yaml (valeurs par défaut identiques si absentes)
WEB_PORT=8081
DB_PORT=3307
MYSQL_DATABASE=mediatheque
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root
###< docker compose ###
