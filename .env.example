# Modèle de configuration : copier vers .env.local pour personnaliser.
# Ce fichier ne doit JAMAIS contenir de vrai secret.

# --- Symfony ---
APP_ENV=dev                                  # dev | test | prod
APP_SECRET=remplacer-par-une-chaine-aleatoire
DEFAULT_URI="http://localhost:8080"

# --- Base de données (le nom d'hôte « database » est le service Docker) ---
DATABASE_URL="mysql://app:app@database:3306/mediatheque?serverVersion=8.0&charset=utf8mb4"

# --- Docker Compose ---
WEB_PORT=8080                                # http://localhost:8080
DB_PORT=3307                                 # accès MySQL depuis la machine hôte
MYSQL_DATABASE=mediatheque
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root
