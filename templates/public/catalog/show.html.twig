{% extends 'base.html.twig' %}

{% block title %}{{ edition.work.title }} — Médiathèques EMC{% endblock %}

{% block body %}
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_catalog') }}">Catalogue</a></li>
        <li class="breadcrumb-item active">{{ edition.work.title }}</li>
    </ol>
</nav>

{# Fiche d'information #}
<div class="card shadow-sm border mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <span class="badge bg-primary mb-2">{{ edition.type.label }}</span>
                <h1 class="h3 fw-bold">{{ edition.work.title }}</h1>
            </div>
        </div>

        <hr>

        <div class="row g-3">
            <div class="col-sm-4">
                <strong>Éditeur :</strong> {{ edition.publisher }}
            </div>
            <div class="col-sm-4">
                <strong>Année :</strong> {{ edition.publicationYear }}
            </div>
            <div class="col-sm-4">
                <strong>ISBN :</strong> {{ edition.isbn }}
            </div>
        </div>
    </div>
</div>

{# Bloc Réservation #}
<div class="card shadow-sm border mb-4">
    <div class="card-header bg-white py-3">
        <h2 class="h5 fw-bold mb-0">
            <i class="bi bi-bookmark-plus me-2 text-primary"></i>Réserver ce document
        </h2>
    </div>
    <div class="card-body p-4">
        {% if is_granted('ROLE_MEMBER') %}
            <p class="text-muted small">
                Vous pouvez réserver ce document pour le retirer dans la médiathèque de votre choix. Si l'exemplaire se trouve dans l'autre médiathèque, un transfert sera automatiquement déclenché.
            </p>
            <form method="post" action="{{ path('app_catalog_reserve', {id: edition.id}) }}" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="pickupSite" class="form-label fw-bold">Médiathèque de retrait souhaitée :</label>
                    <select id="pickupSite" name="site_id" class="form-select" required>
                        {% for site in sites %}
                            <option value="{{ site.id }}">{{ site.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-check2-circle me-1"></i>Confirmer ma réservation
                    </button>
                </div>
            </form>
        {% elseif app.user %}
            <div class="alert alert-info mb-0">
                <i class="bi bi-info-circle me-2"></i>Votre compte actuel ne dispose pas d'un profil adhérent pour effectuer des réservations.
            </div>
        {% else %}
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <strong>Envie d'emprunter ou de réserver ce document ?</strong>
                    <div class="text-muted small">Connectez-vous avec votre compte adhérent pour accéder à la réservation en ligne.</div>
                </div>
                <a href="{{ path('app_login') }}" class="btn btn-outline-primary">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Se connecter pour réserver
                </a>
            </div>
        {% endif %}
    </div>
</div>

{# Liste des exemplaires physiques #}
<h2 class="h4 fw-bold mb-3"><i class="bi bi-geo-alt me-2"></i>Exemplaires physiques par site</h2>
<div class="card shadow-sm border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code-barres</th>
                    <th>Site de rattachement</th>
                    <th>État</th>
                </tr>
            </thead>
            <tbody>
                {% for copy in edition.copies %}
                    <tr>
                        <td><code>{{ copy.barcode }}</code></td>
                        <td>{{ copy.site.name }}</td>
                        <td>
                            {% if copy.status.value == 'available' %}
                                <span class="badge bg-success">{{ copy.status.label }}</span>
                            {% elseif copy.status.value == 'borrowed' %}
                                <span class="badge bg-warning text-dark">{{ copy.status.label }}</span>
                            {% elseif copy.status.value == 'reserved' %}
                                <span class="badge bg-info text-dark">{{ copy.status.label }}</span>
                            {% elseif copy.status.value == 'in_transit' %}
                                <span class="badge bg-primary text-white">{{ copy.status.label }}</span>
                            {% else %}
                                <span class="badge bg-secondary">{{ copy.status.label }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-muted py-3">Aucun exemplaire inventorié.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
