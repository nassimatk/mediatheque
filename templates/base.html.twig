<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Médiathèques EMC{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📚</text></svg>">
    <!-- Bootstrap 5 CDN — aucun build Node.js requis -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ asset('css/theme.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">

{# ── Barre de navigation ── #}
<nav class="navbar navbar-expand-lg navbar-emc">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <i class="bi bi-book-half me-2 text-white"></i>Médiathèques EMC
        </a>
        <button class="navbar-toggler text-white border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto ms-lg-3">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_catalog') }}">
                        <i class="bi bi-search me-1"></i>Catalogue
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_home') }}#sites">
                        Horaires
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_home') }}#services">
                        Services
                    </a>
                </li>
                {% if app.user %}
                    {% if is_granted('ROLE_LIBRARIAN') %}
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold" href="{{ path('app_librarian_desk') }}">
                                <i class="bi bi-person-badge me-1"></i>Comptoir
                            </a>
                        </li>
                    {% endif %}
                    {% if is_granted('ROLE_LIBRARIAN') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin') }}">
                                <i class="bi bi-gear me-1"></i>Back-Office
                            </a>
                        </li>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin_stats') }}">
                                <i class="bi bi-bar-chart me-1"></i>Statistiques
                            </a>
                        </li>
                    {% endif %}
                    {% if is_granted('ROLE_MEMBER') and app.user.member %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_member_dashboard') }}">
                                <i class="bi bi-person-circle me-1"></i>Mon Espace
                            </a>
                        </li>
                    {% endif %}
                {% endif %}
            </ul>
            <ul class="navbar-nav ms-auto align-items-lg-center">
                {% if app.user %}
                    <li class="nav-item dropdown">
                        <a class="btn-nav-auth dropdown-toggle text-decoration-none" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person me-1"></i>{{ app.user.email }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            {% if is_granted('ROLE_MEMBER') and app.user.member %}
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_member_dashboard') }}">
                                        <i class="bi bi-journal-text me-2"></i>Mes emprunts & réservations
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                            {% endif %}
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right me-2"></i>Se déconnecter
                                </a>
                            </li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="btn-nav-auth text-decoration-none" href="{{ path('app_login') }}">
                            <i class="bi bi-person me-1"></i>Se connecter
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

{# ── Flash messages ── #}
<div class="container mt-3">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : (type == 'success' ? 'success' : 'info') }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

{# ── Contenu principal ── #}
<main class="container my-4 flex-grow-1">
    {% block body %}{% endblock %}
</main>

{# ── Pied de page ── #}
<footer class="footer-emc mt-auto">
    <div class="container text-center small">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span><i class="bi bi-book-half me-1"></i><strong>Médiathèques EMC</strong> &mdash; Réseau municipal de lecture publique</span>
            <span>Deux sites de proximité : <strong>Centre-Ville</strong> & <strong>Quartier Nord (Al Amal)</strong></span>
            <span class="text-secondary">&copy; {{ 'now'|date('Y') }} EMC Challenge</span>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
