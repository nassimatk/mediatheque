{% extends 'base.html.twig' %}

{% block title %}Connexion — Médiathèques EMC{% endblock %}

{% block body %}
<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border" style="border-color: var(--emc-border) !important; border-radius: 14px;">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="badge-kicker mb-2">
                        <i class="bi bi-shield-lock"></i> Espace Sécurisé
                    </div>
                    <h1 class="h3 fw-bold mb-1" style="font-family: var(--emc-font-serif);">Connexion</h1>
                    <p class="text-muted small">Accédez à vos prêts, réservations et services du réseau</p>
                </div>

                {% if error %}
                    <div class="alert alert-danger border-0 rounded-3 small">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post">
                    <div class="mb-3">
                        <label for="inputEmail" class="form-label small fw-semibold text-muted">Adresse email</label>
                        <input type="email" id="inputEmail" name="_username"
                               class="form-control"
                               placeholder="nom@mediatheque.ma"
                               value="{{ last_username }}"
                               autocomplete="email" autofocus required>
                    </div>
                    <div class="mb-3">
                        <label for="inputPassword" class="form-label small fw-semibold text-muted">Mot de passe</label>
                        <input type="password" id="inputPassword" name="_password"
                               class="form-control"
                               placeholder="••••••••"
                               autocomplete="current-password" required>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="remember_me" name="_remember_me">
                        <label class="form-check-label small text-muted" for="remember_me">Se souvenir de moi</label>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="d-grid mt-4">
                        <button class="btn btn-emc-navy py-2" type="submit">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Se connecter
                        </button>
                    </div>
                </form>

                <hr class="my-4" style="border-color: var(--emc-border-subtle) !important;">
                <p class="text-center text-muted small mb-0">
                    <a href="{{ path('app_catalog') }}" class="text-decoration-none text-dark fw-semibold">
                        <i class="bi bi-search me-1"></i>Consulter le catalogue sans connexion
                    </a>
                </p>
            </div>
        </div>

        {# Comptes de démo pour évaluation #}
        <div class="card mt-3 border" style="border-color: var(--emc-border) !important; border-radius: 12px; background: #ffffff;">
            <div class="card-header bg-transparent small py-2 fw-semibold text-muted border-bottom" style="border-color: var(--emc-border-subtle) !important;">
                <i class="bi bi-info-circle me-1 text-primary"></i>Comptes de démonstration (PFE Challenge)
            </div>
            <div class="card-body small py-2">
                <table class="table table-sm table-borderless mb-0">
                    <tr><td class="text-muted">Admin</td><td><code>admin@mediatheque.ma</code></td><td><code>admin123</code></td></tr>
                    <tr><td class="text-muted">Bibliothécaire</td><td><code>librarian@mediatheque.ma</code></td><td><code>librarian123</code></td></tr>
                    <tr><td class="text-muted">Adhérent</td><td><code>adherent@mediatheque.ma</code></td><td><code>adherent123</code></td></tr>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
